# App Configuration
APP_NAME=Backend
APP_DESCRIPTION="Financial Tracking API"
APP_VERSION=1.0.0
APP_ENV=Development

# Server Configuration
PORT=5000
HOST=0.0.0.0
HOST_SWAGGER=http://127.0.0.1:5000
MAX_BODY=50mb
MORGAN_FORMAT=combined
CORS_ORIGIN=*

# SSL Configuration (Optional)
SSL_ENABLE=false
SSL_CERT=
SSL_KEY=

# Database Configuration (MySQL / PostgreSQL)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=db_finance_tracker
DB_LOGGING=true
DB_SYNC=true

# Authentication & JWT Configuration
AUTH_KEYSTRING="your-secret-keystring-here"
AUTH_ACCESS_TOKEN_LIFETIME=86400
AUTH_REFRESH_TOKEN_LIFETIME_DAY=30
AUTH_EXPIRED_OTP=10
AUTH_SUSPEND_OTP=60
AUTH_TRY_ATTEMPPIN=3
AUTH_TRY_ATTEMPOTP=5
AUTH_ALGORITHM=aes-256-cbc
