{
    "app": {
        "name": "APP_NAME",
        "description": "APP_DESCRIPTION",
        "version": "APP_VERSION",
        "env": "APP_ENV"
    },
    "server": {
        "port": "PORT",
        "host": "HOST",
        "host_swagger": "HOST_SWAGGER",
        "max_body": "MAX_BODY",
        "morgan": "MORGAN_FORMAT",
        "cors": "CORS_ORIGIN",
        "ssl": {
            "enable": {
                "__name": "SSL_ENABLE",
                "__format": "boolean"
