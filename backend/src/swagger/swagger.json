  "components": {
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "email@example.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          },
          "fullname": {
            "type": "string",
            "example": "your-fullname"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "email@example.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string",
            "example": "your-refresh-token"
          }
        }
      },
      "UpdateRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "email": {
            "type": "string",
            "example": "email@example.com"
          },
          "fullname": {
            "type": "string",
            "example": "your-fullname"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "email@example.com"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "reset-token"
          },
          "newPassword": {
            "type": "string",
            "example": "12345567"
          }
        }
      },
      "ProductCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Product 1"
          },
          "desc": {
            "type": "string",
            "example": "Description of Product 1"
          },
          "price": {
            "type": "string",
            "example": "5.00"
          }
        }
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Product 1"
          },
          "desc": {
            "type": "string",
            "example": "Description of Product 1"
          },
          "price": {
            "type": "number",
            "example": 5
          }
        }
      },
      "Paging": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "any": {
                "type": "string",
                "example": "Product 1"
              }
            }
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 25
          },
          "with_deleted": {
            "type": "boolean",
            "example": true
          },
          "order_field": {
            "type": "string",
            "example": "name"
          },
          "order_direction": {
            "type": "string",
            "example": "desc"
          }
        }
      }
    },
    "parameters": {},
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
