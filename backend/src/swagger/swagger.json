          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "reset-token"
          },
          "newPassword": {
            "type": "string",
            "example": "12345567"
          }
        }
      },
      "ProductCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Product 1"
          },
          "desc": {
            "type": "string",
            "example": "Description of Product 1"
          },
          "price": {
            "type": "string",
            "example": "5.00"
          }
        }
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Product 1"
          },
          "desc": {
            "type": "string",
            "example": "Description of Product 1"
          },
          "price": {
            "type": "number",
            "example": 5
          }
        }
      },
      "Paging": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "any": {
                "type": "string",
                "example": "Product 1"
              }
            }
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 25
          },
          "with_deleted": {
            "type": "boolean",
            "example": true
          },
          "order_field": {
            "type": "string",
            "example": "name"
          },
          "order_direction": {
            "type": "string",
            "example": "desc"
          }
        }
      },
      "CreateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Food & Beverage"
          },
          "type": {
            "type": "string",
            "example": "EXPENSE"
          }
        }
      },
      "UpdateCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Food & Beverage"
          },
          "type": {
            "type": "string",
            "example": "EXPENSE"
          }
        }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "properties": {
          "wallet_id": {
            "type": "number",
            "example": 1
          },
          "category_id": {
            "type": "number",
            "example": 1
          },
          "type": {
            "type": "string",
            "example": "EXPENSE"
          },
          "amount": {
            "type": "number",
            "example": 50000
          },
          "is_pending": {
            "type": "string",
            "example": "N"
          },
          "transaction_date": {
            "type": "string",
            "example": "2026-10-26"
          },
          "description": {
            "type": "string",
            "example": "Makan siang"
          }
        }
      },
      "UpdateTransactionRequest": {
